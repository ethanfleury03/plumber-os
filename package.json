{
  "name": "wny-automation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wnyautomation/portal",
    "dev:portal": "npm run dev --workspace @wnyautomation/portal",
    "dev:marketing": "npm run dev --workspace @wnyautomation/marketing",
    "build": "npm run build --workspaces --if-present",
    "build:portal": "npm run build --workspace @wnyautomation/portal",
    "build:marketing": "npm run build --workspace @wnyautomation/marketing",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:portal": "npm run test --workspace @wnyautomation/portal",
    "test:marketing": "npm run test --workspace @wnyautomation/marketing",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
